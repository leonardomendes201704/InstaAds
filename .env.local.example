# Google AI Studio — https://aistudio.google.com/apikey
GOOGLE_AI_API_KEY=your-google-ai-studio-api-key-here

# Modelo de texto (sugestão de copy)
GEMINI_TEXT_MODEL=gemini-3.6-flash

# Modelo de imagem (arte publicitária com foto do produto)
GEMINI_IMAGE_MODEL=gemini-2.5-flash-image

# Vercel Blob — Storage → insta-ads-blob → conectado ao projeto
# Em produção na Vercel, o SDK usa OIDC + BLOB_STORE_ID (automático).
# Para dev local, conecte o store ao ambiente Development ou use o token:
BLOB_READ_WRITE_TOKEN=vercel_blob_rw_xxxxxxxx
# BLOB_STORE_ID=store_xxxxxxxx   # injetado automaticamente na Vercel

# Store privado (padrão). Use "public" apenas se criou store público.
BLOB_ACCESS=private

# Painel admin (/admin) — senha de acesso
ADMIN_PASSWORD=your-secure-admin-password

# Auth.js — login Google (obrigatório no app)
# Gere AUTH_SECRET com: openssl rand -base64 32
AUTH_SECRET=your-auth-secret
AUTH_URL=http://localhost:3000
AUTH_GOOGLE_ID=your-google-oauth-client-id
AUTH_GOOGLE_SECRET=your-google-oauth-client-secret
#
# Google Cloud Console → OAuth Client (Web):
# Redirect URI dev:  http://localhost:3000/api/auth/callback/google
# Redirect URI prod: https://insta-ads.vercel.app/api/auth/callback/google
